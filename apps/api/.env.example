APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_MODE=mock

# Server-side Supabase configuration. Leave empty until DATABASE_MODE=supabase.
# Do not commit real project URLs, passwords, tokens, JWTs, or keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback for older Supabase projects. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Phase 4A text-only conversation provider. API keys are server-side only.
CONVERSATION_PROVIDER=mock
CONVERSATION_LANGUAGE=tr
GEMINI_API_KEY=
GEMINI_CONVERSATION_MODEL=gemini-3.5-flash-lite
GEMINI_CONVERSATION_THINKING_LEVEL=minimal
CONVERSATION_CONTEXT_TTL_SECONDS=1800

# Phase 4B active voice providers. Keys stay server-side only.
ELEVENLABS_API_KEY=

STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_LANGUAGE=tr
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=0.8

# Retained inactive STT fallback / bake-off provider.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=tr
DEEPGRAM_STT_ENDPOINTING_MS=500
DEEPGRAM_STT_UTTERANCE_END_MS=1000

TTS_PROVIDER=elevenlabs
TTS_LANGUAGE=tr
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_LANGUAGE=tr
ELEVENLABS_TTS_VOICE_ID=
