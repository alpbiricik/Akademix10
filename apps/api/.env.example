APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_MODE=mock

# Server-side Supabase configuration. Leave empty until DATABASE_MODE=supabase.
# Do not commit real project URLs, passwords, tokens, JWTs, or keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback for older Supabase projects. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Phase 4A text-only conversation provider. API keys are server-side only.
CONVERSATION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_CONVERSATION_MODEL=gemini-3.6-flash
CONVERSATION_CONTEXT_TTL_SECONDS=1800
