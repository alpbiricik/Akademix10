APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000

# Supabase
DATABASE_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=your-public-anon-or-publishable-key

# Gemini
CONVERSATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CONVERSATION_MODEL=gemini-3.5-flash-lite
GEMINI_CONVERSATION_THINKING_LEVEL=minimal
CONVERSATION_CONTEXT_TTL_SECONDS=1800

# ElevenLabs
ELEVENLABS_API_KEY=
STT_PROVIDER=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_STT_LANGUAGE=tr
ELEVENLABS_STT_COMMIT_STRATEGY=vad
ELEVENLABS_STT_VAD_SILENCE_THRESHOLD_SECS=0.8
TTS_PROVIDER=elevenlabs
TTS_LANGUAGE=tr
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_LANGUAGE=tr
ELEVENLABS_TTS_VOICE_ID=

# LiveAvatar / HeyGen
LIVE_AVATAR_PROVIDER=heygen
LIVE_AVATAR_SANDBOX=true
LIVE_AVATAR_SANDBOX_AVATAR_ID=dd73ea75-1218-4ef3-92ce-606d5f7fbc0a
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_QUALITY=medium
LIVE_AVATAR_MAX_SESSION_SECONDS=600
